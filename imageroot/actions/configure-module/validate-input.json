{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure rustfs",
    "$id": "http://nethserver.org/json-schema/task/input/rustfs/configure",
    "description": "Configure rustfs",
    "examples": [
        {
            "user": "rustfsadmin",
            "password": "rustfsadmin",
            "host_server": "myrustfs.nethserver.org",
            "host_console": "console.myrustfs.nethserver.org",
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host_server",
        "host_console"
    ],
    "properties": {
        "host_console": {
            "type": "string",
            "description": "Host name for the server, this host will be use by S3 clients",
            "format": "hostname",
            "pattern": "\\."
        },
        "host_server": {
            "type": "string",
            "description": "Host name for the UI, this how will serve the management UI",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "user": {
            "type": "string",
            "description": "Name of the admin user, default is 'rustfsadmin'",
            "minLength": 1
        },
        "password": {
            "type": "string",
            "description": "Password of the admin user",
            "minLength": 1
        }
    }
}

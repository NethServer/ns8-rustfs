{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get rustfs configuration",
    "$id": "http://nethserver.org/json-schema/task/output/rustfs/get-configuration",
    "description": "Get rustfs configuration",
    "examples": [
        {
            "host_console": "console.rustfs.test.local",
            "host_server": "rustfs.test.local",
            "lets_encrypt": true,
            "user": "nethesis"
        }
    ],
    "type": "object",
    "required": [
        "host_server",
        "host_console"
    ],
    "properties": {
        "host_console": {
            "type": "string",
            "description": "Host name for the server, this host will be use by S3 clients",
            "format": "hostname",
            "pattern": "\\."
        },
        "host_server": {
            "type": "string",
            "description": "Host name for the UI, this how will serve the management UI",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "user": {
            "type": "string",
            "description": "Name of the admin user, default is 'rustfsadmin'",
            "minLength": 1
        }
    }
}
